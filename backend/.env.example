# Copia este archivo como .env y completa los valores.
# El .env real NUNCA se sube al repositorio (ya esta en .gitignore).

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development

# ---------- Base de datos MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=travelhub

# ---------- Autenticacion ----------
# Cadena larga y aleatoria. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# Origenes permitidos separados por coma. Vacio = permitir todos (solo en dev).
CORS_ORIGINS=
